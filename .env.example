# Copia este archivo como .env para desarrollo local, o crea estas variables en Vercel.
# Solo SUPABASE_URL, SUPABASE_ANON_KEY y VAPID_PUBLIC_KEY son públicos por diseño. El resto, secretos.

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA: guía espiritual y explicación de las lecturas
# AI_PROVIDER: anthropic u openai (cualquier API compatible: OpenAI, Groq, Gemini...)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_BASE_URL=
AI_DAILY_LIMIT=40
AI_ALLOW_ANON=false

# Recordatorios: genera las claves con npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
CRON_SECRET=

# Opcionales
CONTACT_URL=https://github.com/Cuperttino/Zarzu
PUBLIC_SITE_URL=https://tu-dominio.vercel.app
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# [{"id":"granada","name":"Diócesis de Granada","url":"https://.../feed/","categories":["diocesis"]}]
NEWS_EXTRA_FEEDS=
