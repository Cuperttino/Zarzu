{
  "name": "zarzu",
  "version": "1.0.0",
  "private": true,
  "description": "Zarzu: app católica diaria con Evangelio, oración, templos y noticias.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/dev.mjs --prod",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings scripts/run-tests.mjs",
    "vapid": "node scripts/vapid.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "build:verses": "node scripts/build-verses.mjs"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8" },
  "devDependencies": {
    "@types/node": "^22.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2", "tailwindcss": "4.3.3", "typescript": "6.0.3"
  },
  "engines": { "node": ">=22" }
}
